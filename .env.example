CELCAT_BASE_URL=https://celcat.rambouillet.iut-velizy.uvsq.fr
CELCAT_EDT_URL=https://edt.iut-velizy.uvsq.fr
CACHE_TTL_SECONDS=600
# Local API only; Vercel manages the listening port.
PORT=5000

# Optional shared history. Inject Redis credentials through Vercel Marketplace.
# Vercel Marketplace injects these names:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative direct Upstash credentials (use a complete pair):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# Optional anonymous device tokens (at least 32 random characters, same value on every instance).
TOKEN_SECRET=

# Travaux: accounts and mails (Oracle Email Delivery SMTP through nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
# Postgres (Neon, Vercel Marketplace). Without it, development keeps data in .data/travaux.json
DATABASE_URL=
# Comma-separated administrator addresses
ADMIN_EMAILS=
# Contact address shown to contest a sanction
CONTACT_EMAIL=
