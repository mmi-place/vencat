CELCAT_BASE_URL=https://celcat.rambouillet.iut-velizy.uvsq.fr
CELCAT_EDT_URL=https://edt.iut-velizy.uvsq.fr
CACHE_TTL_SECONDS=600
# Local API only; Vercel manages the listening port.
PORT=5000

# Optional shared history. Inject Redis credentials through Vercel Marketplace.
# Vercel Marketplace injects these names:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative direct Upstash credentials (use a complete pair):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
